{
  "appId": "com.robotariis.terminal-synth",
  "productName": "terminal-synth",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ]
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "category": "Utility"
  },
  "deb": {
    "depends": [
      "libx11-6",
      "libxss1",
      "libnss3"
    ],
    "maintainer": "Olivier Bareau <olivier.bareau@gmail.com>",
    "priority": "optional"
  }
}
