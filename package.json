{
  "name": "terminal-synth",
  "version": "1.9.5",
  "description": "Synthé visuel dark/industriel — shaders GLSL réactifs au son et au MIDI, esthétique terminal/ASCII, live + export. Style VS (Imaginando).",
  "author": "Olivier Bareau",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "start": "tsx build.ts && electron .",
    "dev": "tsx build.ts && electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "tsx build.ts --production && electron-builder --win portable",
    "package:mac": "tsx build.ts --production && electron-builder --mac",
    "package:linux": "tsx build.ts --production && electron-builder --linux",
    "package:deb": "tsx build.ts --production && electron-builder --linux deb"
  },
  "build": {
    "appId": "com.robotariis.terminal-synth",
    "productName": "terminal-synth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Graphics"
    },
    "deb": {
      "depends": [
        "libx11-6",
        "libxss1",
        "libnss3"
      ],
      "maintainer": "Olivier Bareau <olivier.bareau@gmail.com>",
      "priority": "optional"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.19.19",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.0": true,
    "ffmpeg-static@5.3.0": true,
    "electron@34.5.8": true,
    "electron-winstaller@5.4.0": true
  }
}
